<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面布局
  顶部四个标签：脚本 / 日常 / 仙榜 / 活动
  脚本页：状态 -> 游戏信息卡（点击即选择/扫描）-> 功能按钮 -> 运行日志
  日常、仙榜、活动三页由 Pages.java 动态填充。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部四个标签 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF0F0F0"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="0dp">

        <Button
            android:id="@+id/tab_script"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="脚本"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_daily"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="日常"
            android:textSize="14sp" />

        <Button
            android:id="@+id/tab_rank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="仙榜"
            android:textSize="14sp" />

        <Button
            android:id="@+id/tab_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="活动"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFDDDDDD" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= 脚本页 ================= -->
        <LinearLayout
            android:id="@+id/page_script"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingTop="8dp"
            android:paddingRight="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="正在读取状态..."
                android:textSize="12sp" />

            <!-- 游戏信息卡：扫描并选择游戏的功能合并到这里，点击整张卡片即可换游戏 / 扫描 -->
            <LinearLayout
                android:id="@+id/card_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#FFF7F8FA"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="8dp"
                android:paddingRight="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_game"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前游戏: --"
                    android:textColor="#FF1B7A1B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="2dp">

                    <TextView
                        android:id="@+id/tv_game_ver"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--"
                        android:textColor="#FF1F1F1F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_game_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="#FF8A8A8A"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 功能按钮区：顺序固定，可上下滚动 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btn_accounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="账号管理（按游戏分别保存）"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="启动脚本"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="停止脚本"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_library"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="安装包库（各游戏历史版本）"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_perm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="无障碍功能/悬浮窗"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_config"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="配置"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_log_copy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="复制日志"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_clearlog"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="清空日志"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- 运行日志面板：默认隐藏，点底部「上拉箭头」才展开 -->
            <LinearLayout
                android:id="@+id/log_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 日志顶部：下拉箭头，点一下把日志收起来 -->
                <TextView
                    android:id="@+id/btn_log_collapse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFF2F2F2"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="▼  收起运行日志"
                    android:textColor="#FF6A6A6A"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="3dp"
                    android:text="运行日志（每一行是一次动作，越往下越新）"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FF111111">

                    <TextView
                        android:id="@+id/tv_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:textColor="#FF33DD33"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        android:typeface="monospace" />
                </ScrollView>
            </LinearLayout>

            <!-- 页面最底部：上拉箭头，点一下展开运行日志 -->
            <TextView
                android:id="@+id/btn_log_expand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF7F7F7"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="▲  上拉查看运行日志"
                android:textColor="#FF2E8B57"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= 日常页 ================= -->
        <ScrollView
            android:id="@+id/page_daily"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/box_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </ScrollView>

        <!-- ================= 仙榜页 ================= -->
        <ScrollView
            android:id="@+id/page_rank"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/box_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </ScrollView>

        <!-- ================= 活动页 ================= -->
        <ScrollView
            android:id="@+id/page_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/box_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
